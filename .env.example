# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://chitter:chitter@localhost:5433/chitter

# Public base URL, used to build magic links
APP_URL=http://localhost:3000

# Where recordings are stored on disk (relative paths resolve from the project root)
STORAGE_DIR=./storage

# Magic-link email. Leave RESEND_API_KEY empty to log links to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Chittle <login@example.com>

# AI topic generation. Without a key, only predefined topics are served.
ANTHROPIC_API_KEY=
TOPIC_MODEL=claude-haiku-4-5-20251001
